rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /champions/{championId} {
      allow read, write: if true;
    }

    match /builds/{buildId} {
      allow read, write: if true;
    }

    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }
  }
}
